(============================================================) Tj
T*
(// Assignment 1 - Question 14) Tj
T*
(// Name: Zawar Shah) Tj
T*
(// Registration No: BF25NWELE0677) Tj
T*
() Tj
T*
(#include <iostream>) Tj
T*
(using namespace std;) Tj
T*
() Tj
T*
(int main\(\) {) Tj
T*
(    double r1 = 6.0;) Tj
T*
(    double r2 = 3.0;) Tj
T*
(    double voltage = 12.0;) Tj
T*
(    double totalCurrent, currentThroughR2;) Tj
T*
() Tj
T*
(    totalCurrent = voltage / \(\(r1 * r2\) / \(r1 + r2\)\); // Find total current using equivalent parallel resistance) Tj
T*
(    currentThroughR2 = totalCurrent * \(r1 / \(r1 + r2\)\); // Current division formula for the branch containing R2) Tj
T*
() Tj
T*
(    cout << "Selected values: R1 = " << r1 << " ohms, R2 = " << r2 << " ohms, Voltage = " << voltage << " volts" << endl;) Tj
T*
(    cout << "Current through R2 = " << currentThroughR2 << " amperes" << endl;) Tj
T*
(    return 0;) Tj
T*
